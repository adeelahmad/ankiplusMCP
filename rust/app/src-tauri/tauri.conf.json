{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnkiPlus",
  "version": "0.1.0",
  "identifier": "net.ankiplus.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AnkiPlus",
        "width": 1100,
        "height": 780
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.png"]
  }
}
