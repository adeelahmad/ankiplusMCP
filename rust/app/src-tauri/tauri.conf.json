{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnkiPlus",
  "version": "0.5.3",
  "identifier": "net.ankiplus.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AnkiPlus",
        "width": 900,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
